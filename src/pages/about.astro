---
import BaseLayout from "../layouts/BaseLayout.astro";
import Suraj from "../assets/suraj.jpeg";
import Adarsh from "../assets/adarsh.jpeg";
import Team from "../assets/team-2.jpeg";
import Riya from "../assets/riya.jpeg";
---

<BaseLayout title="About Vasudhaiva Kulam">
  <main class="grow">
    <!-- Hero Section -->
    <section
      class="py-section-gap px-gutter bg-surface-container-low relative overflow-hidden"
    >
      <div class="max-w-container-max mx-auto text-center relative z-10">
        <h1
          class="font-display text-display-lg md:font-display md:text-display-lg text-primary mb-6"
        >
          About Us <span class="text-on-surface-variant opacity-70">|</span>
          <span class="font-normal">हमारे बारे में</span>
        </h1>
        <p
          class="font-sans text-body-lg text-on-surface max-w-3xl mx-auto leading-relaxed"
        >
          Rooted in the philosophy of 'Vasudhaiva Kutumbakam' (The World is One
          Family), we strive to build a global kinship through education,
          empowerment, and sustainable community development in India.
        </p>
      </div>
    </section>
    <!-- Genesis & Mission (Bento Grid) -->
    <section class="py-section-gap px-gutter max-w-container-max mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Genesis Story -->
        <div
          class="md:col-span-5 bg-surface rounded-xl p-8 border border-outline-variant/30 shadow-[0_4px_12px_rgba(0,0,128,0.05)]"
        >
          <div class="flex items-center gap-3 mb-6">
            <span
              class="material-symbols-outlined text-primary text-3xl"
              data-icon="history_edu"
              data-weight="fill"
              style="font-variation-settings: 'FILL' 1;">history_edu</span
            >
            <h2 class="font-display text-headline-md text-on-surface">
              Our Genesis <span
                class="text-on-surface-variant font-normal text-xl ml-2"
                >हमारी शुरुआत</span
              >
            </h2>
          </div>
          <div
            class="prose max-w-none text-on-surface-variant font-sans text-body-md space-y-4"
          >
            <p>
              Founded in 2024 by Adarsh bhaiya and Suraj bhaiya in Lucknow,
              Vasudhaiva Kulam began with a simple belief: every person deserves
              access to basic necessities, quality education, quality
              healthcare, and clean environment, regardless of their
              socio-economic background.
            </p>
            <p>
              What started as a small distribution of candles and sweets on the
              occasion of Diwali has now blossomed into a comprehensive NGO
              working for multiple causes.
            </p>
          </div>
          <img
            class="w-full h-64 object-cover rounded-lg mt-6 shadow-sm"
            alt="A group of Indian adults standing in a semi-circle facing the camera."
            src={Team.src}
          />
        </div>
        <!-- Mission Statement -->
        <div class="md:col-span-7 flex flex-col gap-8">
          <div
            class="bg-primary/5 rounded-xl p-8 border-l-4 border-primary h-full flex flex-col gap-8 shadow-[0_4px_12px_rgba(0,0,128,0.05)]"
          >
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span
                  class="material-symbols-outlined text-primary text-3xl"
                  data-icon="track_changes"
                  data-weight="fill"
                  style="font-variation-settings: 'FILL' 1;">track_changes</span
                >
                <h2 class="font-display text-headline-md text-on-surface">
                  Our Mission <span
                    class="text-on-surface-variant font-normal text-xl ml-2"
                    >हमारा लक्ष्य</span
                  >
                </h2>
              </div>
              <div class="mt-auto space-y-3">
                <div
                  class="flex items-center gap-3 text-on-surface font-sans text-body-md"
                >
                  <span
                    class="material-symbols-outlined text-secondary"
                    data-icon="check_circle">check_circle</span
                  > Accessible Education (सुलभ शिक्षा)
                </div>
                <div
                  class="flex items-center gap-3 text-on-surface font-sans text-body-md"
                >
                  <span
                    class="material-symbols-outlined text-secondary"
                    data-icon="check_circle">check_circle</span
                  > Accessible Healthcare (सुलभ स्वास्थ्य सेवा)
                </div>
                <div
                  class="flex items-center gap-3 text-on-surface font-sans text-body-md"
                >
                  <span
                    class="material-symbols-outlined text-secondary"
                    data-icon="check_circle">check_circle</span
                  > Clean Environment (स्वच्छ पर्यावरण)
                </div>
              </div>
            </div>
            <p
              class="font-sans text-body-lg text-on-surface-variant italic mb-6"
            >
              "जब वर्तमान इतिहास बनेगा। <br />
              जब नफ़रतों दौर में प्रेम तलाशा जाएगा। <br />
              जब इंसान अपनी घृणित मानसिकता पर अफ़सोस जताएगा। <br />
              तब ये लिखा जाएगा कि ऐसे प्रतिकूल परिवेश में वसुधैव कुलम् एवं उसके साथी
              प्रेम में लबालब और मनुष्यता के लिए समर्पित थे। <br />
              जाति, धर्म, मजहब एवं संप्रदाय के नाम पर मनुष्य - मनुष्य से दूर होता
              जा रहा है। नफ़रत की दीवार लगातार मोटी होती जा रही है। <br />
              ऐसे दौर में वसुधैव कुलम् एक विचार बनकर आपको धागों में बदलने का काम कर
              रहा है ताकि आप मोटी दीवार के बहुत छोटे से छिद्र से बाहर निकलकर एक दूसरे
              से जुड़ सकें और इंसानियत को जिंदाबाद कर सकें। <br /><br />
              सेवा, संकल्प एवं सृजन के इस मुहिम में आपके साथ, सुझाव एवं स्नेह की अपेक्षा
              है। <br /><br />
              साभार.. <br />वसुधैव कुलम्।।"
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Team Section -->
    <section
      class="py-section-gap px-gutter bg-surface-container-lowest max-w-container-max mx-auto border-t border-outline-variant/20"
    >
      <div class="text-center mb-12">
        <h2 class="font-display text-headline-md text-primary mb-2">
          The Main People Behind the Mission
        </h2>
        <p class="font-sans text-body-lg text-on-surface-variant">
          हमारे मुख्य सदस्य
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Team Member 1 -->
        <div
          class="group bg-surface rounded-xl overflow-hidden shadow-[0_4px_12px_rgba(0,0,128,0.05)] border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
        >
          <img
            alt="Adarsh Dwivedi"
            class="w-full h-72 object-cover object-top"
            src={Adarsh.src}
          />
          <div
            class="p-6 border-l-4 border-secondary/0 group-hover:border-secondary transition-all"
          >
            <h3
              class="font-display text-title-sm font-semibold text-on-surface mb-1"
            >
              Mr. Adarsh Dwivedi
            </h3>
            <p class="font-sans text-body-md text-on-surface-variant mb-4">
              Founder &amp; Director (संस्थापक)
            </p>
            <p class="font-sans text-body-md text-on-surface-variant text-sm">
              Mr. Dwivedi shapes Vasudhaiva Kulam's vision and growth by leading
              strategic planning and educational initiatives focused on
              inclusive learning, community empowerment, and lasting social
              change.
            </p>
          </div>
        </div>
        <!-- Team Member 2 -->
        <div
          class="group bg-surface rounded-xl overflow-hidden shadow-[0_4px_12px_rgba(0,0,128,0.05)] border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
        >
          <img
            alt="Suraj Pandey"
            class="w-full h-72 object-cover object-top"
            src={Suraj.src}
          />
          <div
            class="p-6 border-l-4 border-secondary/0 group-hover:border-secondary transition-all"
          >
            <h3
              class="font-display text-title-sm font-semibold text-on-surface mb-1"
            >
              Mr. Suraj Pandey
            </h3>
            <p class="font-sans text-body-md text-on-surface-variant mb-4">
              Co-founder (सह संस्थापक)
            </p>
            <p class="font-sans text-body-md text-on-surface-variant text-sm">
              Mr. Suraj Pandey strengthens Vasudhaiva Kulam's organizational
              backbone by coordinating volunteers, interns, and city teams
              through empathetic leadership, strategic vision, and effective
              collaboration.
            </p>
          </div>
        </div>
        <!-- Team Member 3 -->
        <div
          class="group bg-surface rounded-xl overflow-hidden shadow-[0_4px_12px_rgba(0,0,128,0.05)] border border-outline-variant/20 hover:shadow-lg transition-all duration-300"
        >
          <img
            alt="Riya Singh"
            class="w-full h-72 object-cover object-top"
            src={Riya.src}
          />
          <div
            class="p-6 border-l-4 border-secondary/0 group-hover:border-secondary transition-all"
          >
            <h3
              class="font-display text-title-sm font-semibold text-on-surface mb-1"
            >
              Miss Riya Singh
            </h3>
            <p class="font-sans text-body-md text-on-surface-variant mb-4">
              Manager (प्रबंधक)
            </p>
            <p class="font-sans text-body-md text-on-surface-variant text-sm">
              Riya manages Vasudhaiva Kulam's day-to-day operations by
              coordinating team members, supporting initiatives, and fostering
              effective collaboration through proactive communication and
              dedicated teamwork.
            </p>
          </div>
        </div>
      </div>
    </section>
