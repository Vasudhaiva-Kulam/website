---
import { causes } from "../../data/causes";
import "../../styles/cause-pages.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return causes.map((cause) => ({
    params: { slug: cause.slug },
    props: { cause },
  }));
}

const { cause } = Astro.props;
const siteName = "Vasudhaiva Kulam";
---

<BaseLayout title="Home - Vasudhaiva Kulam">
  <main>
    <section class="hero">
      <div
        class="hero-image"
        style={`background-image:url('${cause.heroImage}')`}
        aria-hidden="true"
      >
      </div>
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <a class="back-link" href="/cause/">← All causes</a>
        <span class="eyebrow">{cause.eyebrow}</span>
        <div class="hero-copy">
          <h1>{cause.title}</h1>
          <p class="hindi-title">{cause.titleHindi}</p>
          <p class="hero-intro">{cause.intro}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#act">Take action</a>
            <a class="btn btn-ghost" href="#impact">See our focus</a>
          </div>
        </div>
      </div>
    </section>

    <section id="impact" class="section section-white">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">WHY IT MATTERS</span>
            <h2>A focused cause, built around people.</h2>
          </div>
          <p>
            Every cause page follows the same rhythm: explain the need, show how
            the work happens, then make the next step clear.
          </p>
        </div>

        <div class="focus-grid">
          {
            cause.focus.map((item) => (
              <article class="focus-card">
                <span class="card-number">
                  0{cause.focus.indexOf(item) + 1}
                </span>
                <h3>{item.label}</h3>
                <p class="card-hindi">{item.hindi}</p>
                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="container program-layout">
        <div class="section-heading section-heading-stacked">
          <span class="section-kicker">OUR WORK</span>
          <h2>Ways we turn the idea into action.</h2>
          <p>
            Use authentic programme photography and replace this copy with live
            project updates, locations, and verified outcomes as the cause
            grows.
          </p>
        </div>

        <div class="program-stack">
          {
            cause.programs.map((program) => (
              <article class="program-card">
                <div>
                  <span class="program-label">PROGRAMME</span>
                  <h3>{program.title}</h3>
                  <p class="card-hindi">{program.hindi}</p>
                  <p>{program.copy}</p>
                </div>
                <a class="text-link" href="/join/">
                  {program.action} <span>→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="act" class="section section-white">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">GET INVOLVED</span>
            <h2>Choose your way to contribute.</h2>
          </div>
          <p>
            Keep contribution paths specific so visitors can act without
            guessing what their support will do.
          </p>
        </div>

        <div class="ways-grid">
          {
            cause.ways.map((way) => (
              <article class="way-card">
                <span class="way-dot" />
                <h3>{way.title}</h3>
                <p>{way.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-wrap">
      <div class="container">
        <div class="cta-card">
          <div>
            <span class="section-kicker"
              >{cause.name.toUpperCase()} / {cause.hindi}</span
            >
            <h2>{cause.ctaTitle}</h2>
            <p>{cause.ctaCopy}</p>
          </div>
          <div class="cta-actions">
            <a class="btn btn-primary" href="/join/"
              >Donate <span>(दान करें)</span></a
            >
            <a class="btn btn-light" href="/join/">Volunteer</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
